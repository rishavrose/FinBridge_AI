{
  "name": "@rishavsinghhh/finbridgeai-sdk",
  "version": "1.0.1",
  "description": "Connect Any Fintech Database to AI — Official FinBridge AI SDK",
  "author": "Rishav Singh <rishavsinghh1@gmail.com> (https://www.npmjs.com/~rishavsinghhh)",
  "license": "MIT",
  "homepage": "https://finbridgeai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/finbridgeai/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/finbridgeai/sdk/issues"
  },
  "keywords": [
    "fintech",
    "ai",
    "mcp",
    "payments",
    "transactions",
    "payouts",
    "analytics",
    "finbridge",
    "sdk",
    "openai",
    "model-context-protocol"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./payouts": {
      "import": "./dist/modules/payouts.js",
      "require": "./dist/modules/payouts.cjs"
    },
    "./transactions": {
      "import": "./dist/modules/transactions.js",
      "require": "./dist/modules/transactions.cjs"
    },
    "./analytics": {
      "import": "./dist/modules/analytics.js",
      "require": "./dist/modules/analytics.cjs"
    },
    "./ai": {
      "import": "./dist/modules/ai.js",
      "require": "./dist/modules/ai.cjs"
    },
    "./settlements": {
      "import": "./dist/modules/settlements.js",
      "require": "./dist/modules/settlements.cjs"
    },
    "./users": {
      "import": "./dist/modules/users.js",
      "require": "./dist/modules/users.cjs"
    },
    "./monitoring": {
      "import": "./dist/modules/monitoring.js",
      "require": "./dist/modules/monitoring.cjs"
    },
    "./mcp": {
      "import": "./dist/modules/mcp.js",
      "require": "./dist/modules/mcp.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build && npm run typecheck",
    "release": "semantic-release",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "eventemitter3": "^5.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "semantic-release": "^23.0.8",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
