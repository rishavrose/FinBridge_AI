{
  "name": "finbridge-mcp-server",
  "version": "1.0.0",
  "description": "Production-grade MCP server platform — plug-and-play AI middleware for MySQL databases",
  "type": "module",
  "main": "dist/src/server/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "dev:debug": "NODE_OPTIONS='--inspect' tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --fix",
    "generate-tools": "tsx scripts/generate-tools.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:build": "docker build -t finbridge-mcp:latest .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@qdrant/js-client-rest": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.28.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.4",
    "openai": "^4.47.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
